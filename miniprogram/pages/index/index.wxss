.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.eyebrow,
.title {
  display: block;
}

.eyebrow {
  color: #64748b;
  font-size: 24rpx;
}

.title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.state {
  border: 1rpx solid #d1d5db;
  border-radius: 999rpx;
  color: #6b7280;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
}

.state-on {
  background: #dcfce7;
  border-color: #86efac;
  color: #166534;
}

.server,
.panel,
.metrics {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.server {
  padding: 20rpx 24rpx;
}

.server-label,
.server-url {
  display: block;
}

.server-label {
  color: #64748b;
  font-size: 24rpx;
}

.server-url {
  color: #111827;
  font-size: 26rpx;
  margin-top: 6rpx;
  word-break: break-all;
}

.panel {
  padding: 28rpx;
}

.panel-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.panel-row {
  align-items: flex-start;
  display: flex;
  justify-content: space-between;
}

.subtle,
.meta,
.status {
  color: #64748b;
  font-size: 24rpx;
}

.field {
  display: block;
  margin-bottom: 22rpx;
}

.field text {
  color: #374151;
  display: block;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

input,
.picker {
  background: #f8fafc;
  border: 1rpx solid #dbe2ea;
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #111827;
  font-size: 28rpx;
  min-height: 80rpx;
  padding: 0 20rpx;
}

.picker {
  align-items: center;
  display: flex;
}

.grid {
  display: grid;
  gap: 0 18rpx;
  grid-template-columns: 1fr 1fr;
}

.compact {
  min-width: 0;
}

.primary {
  background: #2563eb;
  color: #ffffff;
  font-size: 30rpx;
  height: 84rpx;
  line-height: 84rpx;
  margin-top: 8rpx;
}

.ghost {
  background: #f8fafc;
  border: 1rpx solid #dbe2ea;
  color: #334155;
  font-size: 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
}

.status {
  margin: 8rpx 4rpx 24rpx;
}

.metrics {
  display: grid;
  gap: 1rpx;
  grid-template-columns: 1fr 1fr;
  overflow: hidden;
}

.metric {
  background: #ffffff;
  padding: 24rpx;
}

.metric text,
.metric-value {
  display: block;
}

.metric text {
  color: #64748b;
  font-size: 24rpx;
}

.metric-value {
  color: #111827;
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 8rpx;
  word-break: break-all;
}

.table {
  margin-top: 18rpx;
}

.thead,
.tr {
  display: grid;
  gap: 12rpx;
  grid-template-columns: 1.35fr 1fr 1fr .8fr;
}

.thead {
  color: #64748b;
  font-size: 22rpx;
  padding: 12rpx 0;
}

.tr {
  border-top: 1rpx solid #eef2f7;
  color: #111827;
  font-size: 23rpx;
  padding: 18rpx 0;
}
